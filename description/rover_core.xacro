<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Geometry from docs/research/prototype-geometry.md (m). base_link = rear axle center. -->
    <xacro:property name="wheel_radius" value="0.06676"/>
    <xacro:property name="wheel_width" value="0.0656"/>
    <xacro:property name="wheelbase" value="0.20233"/>
    <xacro:property name="track" value="0.2584"/>
    <xacro:property name="ground_clearance" value="0.04355"/>

    <!-- Simplified body: lower deck from rear (x -0.022) to the depth camera face (x 0.26321). -->
    <xacro:property name="deck_x_min" value="-0.022"/>
    <xacro:property name="deck_x_max" value="0.26321"/>
    <xacro:property name="deck_width" value="0.166"/>
    <xacro:property name="deck_height" value="0.052"/>

    <material name="body_grey"><color rgba="0.6 0.6 0.6 1"/></material>
    <material name="tyre_black"><color rgba="0.1 0.1 0.1 1"/></material>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="base_link"/>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="${(deck_x_min + deck_x_max) / 2} 0 ${ground_clearance - wheel_radius + deck_height / 2}" rpy="0 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <geometry><box size="${deck_x_max - deck_x_min} ${deck_width} ${deck_height}"/></geometry>
            <material name="body_grey"/>
        </visual>
        <collision>
            <geometry><box size="${deck_x_max - deck_x_min} ${deck_width} ${deck_height}"/></geometry>
        </collision>
    </link>

    <!-- Wheels: 4-wheel skid steer. Rear wheels carry encoders; front wheels do not. -->
    <xacro:macro name="wheel" params="name x y">
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${name}_wheel"/>
            <origin xyz="${x} ${y} 0" rpy="${-pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${name}_wheel">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="tyre_black"/>
            </visual>
            <collision>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:wheel name="rear_left" x="0" y="${track / 2}"/>
    <xacro:wheel name="rear_right" x="0" y="${-track / 2}"/>
    <xacro:wheel name="front_left" x="${wheelbase}" y="${track / 2}"/>
    <xacro:wheel name="front_right" x="${wheelbase}" y="${-track / 2}"/>

</robot>
